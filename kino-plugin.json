{
  "id": "hentaird",
  "name": "HentaiRD",
  "version": "1.2.0",
  "apiVersion": 20,
  "entry": "plugin.js",
  "description": "Hentai subtitulado al español desde hentaird.tv. Resolve principal con kino-resolver (Lulu, StreamHLS, VOE, StreamWish…); extractores locales de respaldo. Contenido +18.",
  "author": "Hotaru Yume",
  "creator": "hotaruyume",
  "homepage": "https://github.com/agapito309pro/kinoejemplo-1",
  "hosts": [
    "hentaird.tv",
    "luluvid.com",
    "*.luluvid.com",
    "luluvido.com",
    "*.luluvido.com",
    "lulustream.com",
    "*.lulustream.com",
    "sendvid.com",
    "*.sendvid.com",
    "streamhls.to",
    "*.streamhls.to",
    "savefiles.com",
    "*.savefiles.com",
    "upfiles.com",
    "usersdrive.com",
    "byseraguci.com",
    "bysefujedu.com",
    "streamwish.to",
    "*.streamwish.to",
    "voe.sx",
    "*.voe.sx",
    "vidhidepro.com",
    "*.vidhidepro.com",
    "gupload.site",
    "*.gupload.site",
    "firestream.to",
    "*.firestream.to",
    "frstream.life",
    "*.frstream.life",
    "tnmr.org",
    "*.tnmr.org"
  ],
  "streamHosts": "any",
  "fetchHosts": "any",
  "browser": true,
  "capabilities": [
    "search",
    "home",
    "browse",
    "episodes",
    "resolve",
    "download"
  ],
  "categories": [
    "anime",
    "adult"
  ],
  "color": "#007575",
  "icon": "icon.png",
  "recommends": [
    "xuper-plugin/kino-plugin-kino-resolver"
  ],
  "consumes": {
    "resolver": {
      "repo": "xuper-plugin/kino-plugin-kino-resolver",
      "door": "resolver",
      "calls": [
        "resolve"
      ]
    }
  },
  "settings": [
    {
      "key": "server",
      "label": "Servidor preferido",
      "type": "select",
      "default": "auto",
      "hint": "Automático usa kino-resolver (StreamHLS/Lulu primero).",
      "options": [
        {
          "value": "auto",
          "label": "Automático (más rápidos primero)"
        },
        {
          "value": "streamhls",
          "label": "StreamHLS (más rápido)"
        },
        {
          "value": "lulu",
          "label": "Lulu (rápido)"
        },
        {
          "value": "byse",
          "label": "Byse"
        },
        {
          "value": "sendvid",
          "label": "Sendvid"
        },
        {
          "value": "streamwish",
          "label": "StreamWish"
        },
        {
          "value": "voe",
          "label": "VOE"
        },
        {
          "value": "vidhide",
          "label": "VidHide"
        },
        {
          "value": "gupload",
          "label": "Gupload (lento)"
        },
        {
          "value": "firestream",
          "label": "Firestream (lento)"
        }
      ]
    }
  ]
}
